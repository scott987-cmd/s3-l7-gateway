# ============================================================================
# S3 兼容对象存储网关配置 —— 复制为 .env 后填写。⚠ .env 含真实凭证,勿提交/外发。
# ============================================================================

# ---- 真实 S3 endpoint(不带协议,仅 host)。优先填内网/VPC endpoint ----
#   示例(Volcengine TOS 北京内网): tos-s3-cn-beijing.ivolces.com
#   示例(AWS S3): s3.cn-north-1.amazonaws.com.cn
S3_ENDPOINT_HOST=<s3-endpoint-host>

# ---- bucket virtual-hosted 域名(不带协议)。某些 S3 兼容存储不接受 path-style 上游访问。----
# 客户端仍对网关使用 path-style；nginx 去掉 /<bucket> 前缀后，sigv4-proxy 用该 host 重签回源。
S3_BUCKET_HOST=<bucket>.<s3-endpoint-host>

# ---- 签名 region(与端点一致;也是 authd 期望的客户端签名 region)----
S3_REGION=cn-beijing

# ============================================================================
# 真实 S3 凭证获取
# ----------------------------------------------------------------------------
# sigv4-proxy 不从 env 读取固化的 S3_ACCESS_KEY/S3_SECRET_KEY;改由 creds 边车
# (Go creds 二进制,以 --serve 常驻)按 S3_CREDS_SOURCE 选源获取并【到期前自动续期】,
# 通过本机 AWS container credentials endpoint 供 sigv4-proxy 按 provider 语义刷新。
#
#   S3_CREDS_SOURCE = static | auto | imds | sts
#     static : 通用 S3 兼容对象存储，客户提供一把桶 AK/SK 时直用(默认)。
#     imds   : Volcengine ECS 等支持兼容元数据服务的主机，绑定实例角色。
#     sts    : Volcengine STS AssumeRole，用长期 AK/SK 换临时凭证。
#     auto   : 依次 imds→sts→static 回退，仅建议 Volcengine 环境使用。
#
# 👉 非 Volcengine 的 S3 兼容对象存储请保持 S3_CREDS_SOURCE=static。
# ============================================================================
S3_CREDS_SOURCE=static

# ---- (static) 通用 S3 静态凭证:与客户端虚拟 AK/SK 不同 ----
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SESSION_TOKEN=
S3_STATIC_RENEW=43200

# ---- (Volcengine imds) 云实例角色(仅支持元数据服务的云主机;绑定角色后留空即自动列举)----
VOLC_IMDS_ROLE=
VOLC_IMDS_HOST=100.96.0.96

# ---- (Volcengine sts) 长期 AK/SK 仅用于换 STS 临时凭证,不进运行态 ----
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_ROLE_TRN=
VOLC_ROLE_SESSION_NAME=s3gw
VOLC_STS_DURATION=3600
VOLC_STS_HOST=sts.volcengineapi.com
VOLC_STS_REGION=cn-north-1

# ---- authd 重放防护与时钟窗口 ----
# 时钟偏差窗口(秒)。SigV4 对时钟敏感;300s 已足够容忍常见 NTP 漂移,
# 同时把"合法签名可被重放的时间窗"压到 5 分钟(原 900s)。
AUTHD_MAX_SKEW=300
# 全局一次性 signature replay cache:对【所有方法】查重。默认关,避免误拒读类 SDK 重试/重复 GET/HEAD。
# 仅当客户端引入显式 nonce 并参与签名时才建议设为 1。
AUTHD_REPLAY_CACHE=0
# 写方法(PUT/POST/DELETE/PATCH)强制一次性重放校验。默认【开启】(1)。
#   动因:authd 只验请求头不验体、上游 UNSIGNED-PAYLOAD 重签,写请求签名一旦被重放即可篡改/覆盖对象。
#   如遇写类重试被误拒的极端场景可临时设 0 关闭(不建议长期关闭)。
AUTHD_REPLAY_WRITES=1

# ---- 网关对外监听地址与端口(宿主机)----
# 本地自测默认 127.0.0.1；作为 CLB 后端或对内网开放时设 GW_BIND_ADDR=0.0.0.0。
GW_BIND_ADDR=127.0.0.1
GW_LISTEN_PORT=8443
# Nginx 只接受这些 Host；127.0.0.1/localhost 会自动保留给容器健康检查。
# 多个域名用空格分隔，如: gw.example.com internal-gw.example.local
GW_SERVER_NAMES=''
# /healthz 来源限制；默认仅本机和常见内网网段可访问。公网 CLB healthcheck 请加入 CLB 源网段。
HEALTH_ALLOW_DIRECTIVES='allow 127.0.0.1; allow 10.0.0.0/8; allow 100.64.0.0/10; allow 172.16.0.0/12; allow 192.168.0.0/16; deny all;'

# ---- 资源限制 ----
# 大对象高并发 PUT 时 aws-sigv4-proxy 可能占用较多内存；默认限制 4g，防止拖垮宿主。
SIGV4_PROXY_MEM_LIMIT=4g

# ---- 冒烟测试用:目标桶名与一个测试对象 key ----
TEST_BUCKET=demo-bucket-test
TEST_KEY=s3gw-smoke-test.txt

# ---- 客户端虚拟凭证(由 scripts/gen_keys.sh 生成到 auth/keys.json)----
#   冒烟测试会用这对虚拟 AK/SK 去请求网关(标准 S3 SigV4)。
TEST_VIRT_AK=
TEST_VIRT_SK=
